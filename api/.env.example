# api/.env.example
# Copy this file to .env and replace the placeholder with your own hosted
# PostgreSQL connection string (Neon or Supabase session pooler, port 5432).
# The real .env is gitignored - never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
